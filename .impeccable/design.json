  "narrative": {
    "northStar": "The Trusted Advisor",
    "overview": "Lynkers should feel like a calm consultant sitting next to the buyer: clear, honest and in no hurry to push. The page is mostly white paper and deep navy, with photography of real homes doing the emotional work and the interface staying out of the way. Coral appears only where the buyer can act or where something is genuinely new, so it keeps its meaning.\n\nDensity is moderate. Sections breathe with even spacing, cards sit on thin borders rather than heavy shadows, and every price is shown with its down payment, years and monthly installment so nothing feels hidden. The whole site is Arabic and right-to-left; Kufi headings give it a confident, modern Egyptian voice while the Sans body keeps long text easy to read.\n\nThe user explicitly rejected dark \"luxury\" gold styling, heavy dark sections, background patterns, scattered decoration and anything that looks copied from Nawy.",
    "keyCharacteristics": [
      "White and navy foundation; coral reserved for actions and \"new\".",
      "Real property photography carries the mood; no illustrations or textures.",
      "Thin borders at rest, a soft shadow only on hover.",
      "One radius family (10 / 12 / 16 / 20px) and pill chips for small filters.",
      "Arabic RTL, Kufi headings, Sans body, Cormorant only for the \"Lynkers\" wordmark."
    ],
    "rules": [
      {
        "name": "The Coral Means Act Rule",
        "body": "Coral appears on buttons the buyer can press and on \"new\" or \"offer\" labels. Prices, numbers and data stay navy.",
        "section": "colors"
      },
      {
        "name": "The Accessible Coral Rule",
        "body": "White text never sits on #e8604c; fills behind text use Coral Ink #c4432c.",
        "section": "colors"
      },
      {
        "name": "The No Eyebrow Rule",
        "body": "No small label above a heading. The heading carries its own weight.",
        "section": "typography"
      },
      {
        "name": "The Tabular Price Rule",
        "body": "Prices, stats and tables use tabular numerals so figures line up.",
        "section": "typography"
      },
      {
        "name": "The One Elevation Rule",
        "body": "A card has a border or a shadow, never a wide shadow under a border at rest.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep coral for actions and \"new\"; show prices and numbers in Advisor Navy.",
      "Do use Coral Ink #c4432c behind any white text.",
      "Do keep every card on a 1px #e3e8ef border with the 16px radius, and add shadow only on hover.",
      "Do show price, down payment, years and monthly installment together, and label demo or estimated values.",
      "Do keep sections on the 56px rhythm and alternate white and #f6f8fb bands.",
      "Do check every page at 375px for horizontal overflow."
    ],
    "donts": [
      "Don't use gold, dark \"luxury\" sections or heavy dark backgrounds (the map's space intro is the only dark surface).",
      "Don't add background patterns, dot grids, blobs, rings or other decoration.",
      "Don't put an eyebrow label above a heading or number sections \"01 / 02\".",
      "Don't nest a card inside a card or stack many chips on top of a photo.",
      "Don't give each developer a different bright color; monograms stay #eef2f8 with navy letters until real logos arrive.",
      "Don't copy Nawy's or The Village's content, images or logos."
    ]
  }
}